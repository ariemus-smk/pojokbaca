# ==============================================================================
# PENGAMANAN DIREKTORI UNGGAHAN (UPLOADS)
# ==============================================================================

# Nonaktifkan penjelajahan isi folder
Options -Indexes -ExecCGI

# Larang eksekusi semua berkas skrip yang dapat dijalankan
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|cgi|pl|exe|sh|py|jsp|asp|html|htm)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
