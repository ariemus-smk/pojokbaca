# ==========================================
# .gitignore untuk Pojok Baca Pa'edah
# ==========================================

# 1. Berkas Sistem Operasi (OS Artifacts)
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# 2. Pengaturan IDE & Text Editor
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PhpStorm
.idea/
*.iws
*.iml

# Sublime Text & Editor Lainnya
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 3. Berkas Lingkungan & Konfigurasi Lokal
.env
.env.local
.env.*.local
*.local.php

# 4. Berkas Log & Server Runtime
*.log
logs/
error_log
php_error.log
access_log

# 5. Berkas Cadangan & Arsip Sementara
*.bak
*.backup
*.old
*.orig
*.tmp
*.temp
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# 6. Direktori Unggahan Dinamis Pengguna
# Abaikan berkas yang diunggah saat sistem berjalan,
# namun tetap pertahankan struktur folder via .gitkeep dan banner utama.
uploads/covers/*
!uploads/covers/.gitkeep

uploads/artikel/*
!uploads/artikel/.gitkeep

uploads/galeri/*
!uploads/galeri/.gitkeep

# Pertahankan banner resmi di folder uploads/img
!uploads/img/banner.jpeg

# 7. Dependensi & Package Manager (Jika digunakan di kemudian hari)
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
